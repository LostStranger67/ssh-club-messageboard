*.log
*.pid
*.bak
.playwright-mcp/

# python caches
__pycache__/

# local tooling / notes (not part of the public project)
chatbot/
SEO_STRATEGY.md

# machine configuration — never public (users, paths, hosts)
systemd/

# machine configuration is already above; one-off/local tooling too —
