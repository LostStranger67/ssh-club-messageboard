# are tracked; everything else in helper_scripts is server-local history
helper_scripts/*
!helper_scripts/admin_delete.js
!helper_scripts/messageboard_tool.py
server.sh
credits.json
radio/init-db.js
playlist_metadata.json
radio/tools/
