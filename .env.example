HASH_SALT="Don't make 'em too salty"
THREAD_LIMIT=20
PORT=3000

# --- Graffiti wall size -----------------------------------------------------
# THE single source of truth for the wall dimensions. The server validates
# pixels against these, and the browser renderer, the PNG exporter and the
# wall's CSS box all derive from them (served via /api/graffiti/config and
# injected as --wall-cols/--wall-rows on /wall). Changing them here is enough;
# no other file needs editing. Restart the server after changing.
#
# Limits: 10-2000 each. The pixel cap (WALL_WIDTH * WALL_HEIGHT * 4) and the
# JSON body limit are derived from these automatically.
GRAFFITI_WALL_WIDTH=200
GRAFFITI_WALL_HEIGHT=55
